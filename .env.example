# Copy this file to `.env` and set your own values. NEVER commit `.env` or real credentials.
# Do not wrap values in quotes (the backend loads this file as a Java properties file).

# --- PostgreSQL / PostGIS (used by docker-compose.yml and the backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geonexus
DB_USERNAME=geonexus_app
# Choose a long, unique password for local use. "change_me" is only a placeholder.
DB_PASSWORD=change_me

# --- Backend ---
SERVER_PORT=8080
# Comma-separated exact origins allowed to call the API from a browser. Wildcards are rejected.
GEONEXUS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (only VITE_-prefixed values are visible to browser code) ---
# API base URL used by the browser. The default same-origin path works with the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server forwards /api requests during development.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
