# Copy this file to `.env` and set your own values. NEVER commit `.env` or real credentials.
# Do not wrap values in quotes (the backend loads this file as a Java properties file).

# --- PostgreSQL / PostGIS (used by docker-compose.yml and the backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geonexus
DB_USERNAME=geonexus_app
# Choose a long, unique password for local use. "change_me" is only a placeholder.
DB_PASSWORD=change_me
DB_SSL_MODE=prefer

# --- Neon PostgreSQL (optional: when connecting with Neon cloud database) ---
# Neon generates pooled (app queries) and unpooled (Flyway DDL) connection URLs.
# DATABASE_URL=postgresql://user:password@ep-...-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-...region.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-...-pooler.region.aws.neon.tech:5432/neondb?sslmode=require
# SPRING_FLYWAY_URL=jdbc:postgresql://ep-...region.aws.neon.tech:5432/neondb?sslmode=require

# --- Backend ---
SERVER_PORT=8080
# Comma-separated exact origins allowed to call the API from a browser. Wildcards are rejected.
GEONEXUS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Security (Phase 3) ---
# REQUIRED. Base64 of at least 32 random bytes. The application refuses to start without it.
# Generate one per environment:  openssl rand -base64 48
# Never commit a real value; never reuse across environments.
GEONEXUS_SECURITY_JWT_SECRET=
# Optional (defaults shown)
GEONEXUS_SECURITY_JWT_ISSUER=geonexus
GEONEXUS_SECURITY_JWT_AUDIENCE=geonexus-api
# ISO-8601 duration, must be > 0 and <= 24h
GEONEXUS_SECURITY_JWT_ACCESS_TOKEN_TTL=PT30M
GEONEXUS_SECURITY_CORS_MAX_AGE_SECONDS=3600
# Login brute-force limiter (per username + client IP, in-memory)
GEONEXUS_SECURITY_LOGIN_MAX_FAILED_ATTEMPTS=5
GEONEXUS_SECURITY_LOGIN_LOCKOUT_WINDOW=PT15M

# --- Production Initial Admin Account Bootstrap (Phase 1) ---
# Set ENABLED=true on initial deployment to provision the first ADMIN account into the database.
# Never commit real credentials; configure securely in your deployment environment.
GEONEXUS_SECURITY_BOOTSTRAP_ADMIN_ENABLED=false
GEONEXUS_SECURITY_BOOTSTRAP_ADMIN_USERNAME=admin
GEONEXUS_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_secure_admin_password
GEONEXUS_SECURITY_BOOTSTRAP_ADMIN_EMAIL=admin@geonexus.internal
GEONEXUS_SECURITY_BOOTSTRAP_ADMIN_DISPLAY_NAME=Cadastral Administrator

# --- Frontend (only VITE_-prefixed values are visible to browser code) ---
# API base URL used by the browser. The default same-origin path works with the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server forwards /api requests during development.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# --- Database tests (optional, test-only; never commit real values) ---
# By default `mvn test` starts a throw-away PostGIS container via Testcontainers (needs Docker engine pipe).
# When running in environments where Docker daemon named pipes are restricted, point the tests at the
# running PostGIS container (or any scratch PostGIS server whose role has CREATEDB permissions).
# Each integration test class dynamically creates, applies all Flyway migrations to, and cleans up its own scratch DB:
# GEONEXUS_TEST_DB_URL=jdbc:postgresql://localhost:5433/geonexus
# GEONEXUS_TEST_DB_USER=geonexus_app
# GEONEXUS_TEST_DB_PASSWORD=change_me
